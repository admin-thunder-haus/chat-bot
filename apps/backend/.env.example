# Backend env for running LOCALLY (outside Docker). Copy to apps/backend/.env
# When running via docker-compose, values come from the root .env instead.

NODE_ENV=development
BACKEND_PORT=4000

# Local dev connects to the Postgres container exposed on host port 5435.
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/ai_support?schema=public

JWT_ACCESS_SECRET=dev-access-secret-change-me-at-least-32-chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-at-least-32-chars-diff
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

CORS_ORIGINS=http://localhost:3000

BCRYPT_SALT_ROUNDS=12
JSON_BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
REFRESH_RATE_LIMIT_WINDOW_MS=60000
REFRESH_RATE_LIMIT_MAX=60

# Separate database for the test suite (never the dev DB).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5435/ai_support_test?schema=public

# --- Public legal pages (/privacy and /terms) ---
# The blanks in the legal TEMPLATE. Every one is business-specific, so nothing is
# invented in code: while a value is empty the page shows a highlighted
# "[ FILL IN: … ]" placeholder and a banner listing what is missing. Fill all
# five before sending the URLs to Meta app review or to an EU customer.
# NOT legal advice — have the final text reviewed. See docs/LAUNCH-CHECKLIST.md.
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_ADDRESS=
LEGAL_CONTACT_EMAIL=
# How long data is kept after an account closes, e.g. "30 days".
LEGAL_DATA_RETENTION=
# Country whose law governs the terms, e.g. "Jordan".
LEGAL_JURISDICTION=
LEGAL_LAST_UPDATED=July 2026

# --- Email verification (registration) ---
# When true, new registrations must confirm a 6-digit emailed code before
# logging in. Without SMTP_HOST the mailer logs emails instead of sending, so
# dev works without an SMTP account (read the code from the server logs).
EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_CODE_TTL_MS=900000
EMAIL_VERIFICATION_RESEND_COOLDOWN_MS=60000
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Per-operation SMTP timeout (connect / greeting / socket). Short on purpose: a
# hung relay must not tie up a job worker.
SMTP_TIMEOUT_MS=10000
# ⚠️  MUST be changed the moment SMTP_HOST is set. Relays (Brevo, SendGrid, ...)
# REJECT any From address that is not a verified sender in the account, so
# leaving this default with real SMTP configured makes EVERY email fail. The app
# warns about exactly this at startup.
EMAIL_FROM=AI Support <no-reply@localhost>

# --- Day 4: AI (OpenAI) ---
AI_FEATURE_ENABLED=false
# Platform-wide KILL SWITCH for automatic replies, not the opt-in. Defaults to
# true when unset; the real opt-in is each company's own "Auto-reply" toggle
# (off by default). Set to false to disable auto-reply for every company.
AI_AUTO_REPLY_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_OUTPUT_TOKENS=500
OPENAI_MAX_RETRIES=2
OPENAI_TEMPERATURE=0.3
AI_CONTEXT_MAX_CHARACTERS=30000
AI_CONVERSATION_HISTORY_LIMIT=12
AI_DAILY_COMPANY_REQUEST_LIMIT=1000
AI_MONTHLY_COMPANY_TOKEN_LIMIT=1000000
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=30

# --- Day 11: voice transcription + PDF knowledge ---
# Voice notes are transcribed with OpenAI (uses OPENAI_API_KEY) when AI is on.
AI_TRANSCRIPTION_ENABLED=true
OPENAI_TRANSCRIPTION_MODEL=whisper-1
# Per-file size cap for uploaded knowledge PDFs (MB).
KNOWLEDGE_DOC_MAX_FILE_MB=10

# --- Day 7: Instagram Messaging (Meta) — non-secret global config ---
# Per-account secrets are supplied at connect time + encrypted (never via env).
INSTAGRAM_PROVIDER_ENABLED=true
INSTAGRAM_GRAPH_API_BASE_URL=https://graph.instagram.com
INSTAGRAM_GRAPH_API_VERSION=v21.0
INSTAGRAM_API_TIMEOUT_MS=15000

# --- Day 8: Facebook Messenger (Meta) — non-secret global config ---
FACEBOOK_PROVIDER_ENABLED=true
FACEBOOK_GRAPH_API_BASE_URL=https://graph.facebook.com
FACEBOOK_GRAPH_API_VERSION=v21.0
FACEBOOK_API_TIMEOUT_MS=15000

# --- Day 9: Telegram Bot API — non-secret global config ---
TELEGRAM_PROVIDER_ENABLED=true
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_API_TIMEOUT_MS=15000

# --- Day 5 Part 2: channel delivery retry sweeper ---
# The in-process timer that re-attempts deliveries whose backoff has elapsed and
# re-queues deliveries orphaned in SENDING by a restart. Without it nothing ever
# reads nextAttemptAt, so a transient send failure is never retried.
CHANNEL_RETRY_SWEEP_MS=60000
CHANNEL_RETRY_SWEEP_ENABLED=true

# --- Day 12: Meta OAuth / Embedded Signup (one-click channel connect) ---
# Optional. When META_APP_ID/META_APP_SECRET are unset the OAuth flow is
# disabled and manual connect remains the only path. See docs/META-OAUTH.md.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0
# Embedded Signup configuration id (WhatsApp product in the Meta app).
WHATSAPP_ES_CONFIG_ID=
# Facebook Login for Business configuration id (Messenger).
META_LOGIN_CONFIG_ID=

# Instagram uses "Instagram API with Instagram Login", a DIFFERENT app identity
# from META_APP_ID/META_APP_SECRET above even though it lives in the same Meta
# app: Meta app dashboard > Instagram > API setup with Instagram login. It is
# the only Instagram model that can receive `messages` webhooks, and its secret
# is what signs them — using the Facebook secret fails every signature silently.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Where the browser lands after the OAuth callback (the dashboard origin).
FRONTEND_APP_URL=http://localhost:3000
# Verify token for the SHARED Meta webhook endpoints
# (/api/v1/webhooks/{facebook,instagram,whatsapp} — no account id in the URL).
# A Meta app has ONE callback URL for every tenant it serves, so this is a
# PLATFORM secret you set here and paste once into the Meta dashboard; customers
# never see it. Any long random string. Leave EMPTY to keep the shared endpoints
# off, with every channel using its own per-account webhook URL.
META_WEBHOOK_VERIFY_TOKEN=

# --- Day 12: billing & subscriptions ---
# MASTER SWITCH for the entire billing module. Keep it 'false' while customers
# are invoiced offline (bank transfer / cash): no plan limit is enforced, no
# trial subscription is created, the /api/v1/billing/* endpoints answer 410,
# and the dashboard hides the Billing page. Set it to 'true' — this ONE
# variable, nothing else — to sell monthly/yearly subscriptions again.
BILLING_ENABLED=false
# Free-trial length for new companies (days). Only used when billing is on.
BILLING_TRIAL_DAYS=14
# Stripe is OPTIONAL. Leave STRIPE_SECRET_KEY empty for OFFLINE billing mode
# (plan changes apply immediately, no checkout). Set both for hosted checkout
# with verified webhooks (POST /api/v1/billing/webhook/stripe).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Day 12: AI actions ---
# Master switch for AI-performed business actions (book appointments, create
# orders/support tickets, availability lookups). Per-company AI settings and
# AI_FEATURE_ENABLED still gate whether the AI replies at all.
AI_ACTIONS_ENABLED=true

# --- Login audit trail ---
# How long a recorded sign-in attempt is kept before it is pruned. Pruning is
# opportunistic: roughly one login in a hundred also deletes expired rows, so
# there is no extra timer. Set LOGIN_AUDIT_PRUNE_ENABLED=false only if you prune
# from outside the app (cron/SQL).
LOGIN_AUDIT_RETENTION_DAYS=90
LOGIN_AUDIT_PRUNE_ENABLED=true

# --- Error tracking (Sentry) ---
# FULLY OPTIONAL and empty by default: with no DSN the SDK is never loaded, so
# local dev and the test suite do zero Sentry work. Set SENTRY_DSN in staging /
# production only. SENTRY_ENVIRONMENT defaults to NODE_ENV. Tracing stays off
# (0) — this integration reports unexpected server errors, nothing else.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0

# --- File storage (images, voice notes, knowledge PDFs) ---
# FULLY OPTIONAL and empty by default: with any of these unset, uploaded bytes
# are stored INSIDE POSTGRES exactly as they always have been. That is the mode
# local dev and the whole test suite run in — nothing here is needed to work on
# the project.
# Set ALL FIVE (endpoint, bucket, key id, secret, public base URL) to switch NEW
# uploads to an S3-compatible bucket (Cloudflare R2 or AWS S3). Existing rows
# keep working untouched; move them with:
#   npx tsx scripts/migrate-storage-to-s3.ts --dry-run
# Cloudflare R2 example:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_PUBLIC_BASE_URL=https://<public-bucket-or-custom-domain>
#   S3_REGION=auto            <- R2 REQUIRES the literal 'auto'
# AWS S3: use the regional endpoint and set S3_REGION to the bucket's region.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_REGION=auto
